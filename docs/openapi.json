{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprovalFlow API",
    "description": "Public API for invoice submission, human review, payments, and reporting. All access goes through this gateway; internal services are not exposed.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service liveness",
        "description": "Simple liveness check; does not test downstream dependencies.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "post": {
        "summary": "Submit an invoice",
        "description": "Accepts an invoice for asynchronous processing and returns its tracking id.\n\nDuplicates are detected immediately: the reply then carries status\n`duplicate` and a link to the original invoice.",
        "operationId": "submit_invoice_invoices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry after the given delay"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{tracking_id}": {
      "get": {
        "summary": "Look up an invoice",
        "description": "Returns the submitted fields, current status, decision (with policy rules\nand provider details), payment summary, and review history.",
        "operationId": "get_invoice_invoices__tracking_id__get",
        "parameters": [
          {
            "name": "tracking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Unknown tracking id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/approvals/queue": {
      "get": {
        "summary": "List invoices waiting for human review",
        "description": "Returns pending-review invoices, oldest first, each with the\nrecommendation, confidence, rule ids, and plain-language reason.",
        "operationId": "approvals_queue_approvals_queue_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Approval and payment totals",
        "description": "Returns overall counts and USD amounts: invoices by status, auto-approved\nversus human-approved, escalations, duplicates, and payments.",
        "operationId": "dashboard_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/invoices/{tracking_id}/trail": {
      "get": {
        "summary": "Full processing history of one invoice",
        "description": "Returns one combined view: submitted data, correlation id, revision,\ndecision details, review actions, duplicates, payment outcome, and\nnotifications.",
        "operationId": "invoice_trail_invoices__tracking_id__trail_get",
        "parameters": [
          {
            "name": "tracking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Unknown tracking id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "summary": "Outcome notifications for a submitter",
        "description": "Returns durable notifications for final invoice outcomes, newest first.",
        "operationId": "notifications_notifications_get",
        "parameters": [
          {
            "name": "submitter_email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Submitter Email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/approvals/{tracking_id}/actions": {
      "post": {
        "summary": "Approve, reject, or request more information",
        "description": "Applies one reviewer action to a pending-review invoice. Replaying the\nsame idempotency key returns the recorded outcome instead of acting twice.",
        "operationId": "review_action_approvals__tracking_id__actions_post",
        "parameters": [
          {
            "name": "tracking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewActionResult"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tracking id"
          },
          "409": {
            "description": "The invoice is no longer awaiting review"
          },
          "429": {
            "description": "Rate limit exceeded; retry after the given delay"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{tracking_id}/additional-info": {
      "post": {
        "summary": "Add requested information to an invoice",
        "description": "Accepts the structured details a reviewer asked for and sends the same\ninvoice for another evaluation round, keeping its tracking id.",
        "operationId": "additional_info_invoices__tracking_id__additional_info_post",
        "parameters": [
          {
            "name": "tracking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tracking Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdditionalInfo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdditionalInfoResult"
                }
              }
            }
          },
          "404": {
            "description": "Unknown tracking id"
          },
          "409": {
            "description": "The invoice is not waiting for more information"
          },
          "429": {
            "description": "Rate limit exceeded; retry after the given delay"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdditionalInfo": {
        "properties": {
          "attendees": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Attendees"
          },
          "receipt_present": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Present"
          },
          "business_justification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Justification"
          },
          "client_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Name"
          },
          "travel_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Travel Class"
          },
          "line_items": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/LineItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Items"
          },
          "tax_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Amount"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          }
        },
        "type": "object",
        "title": "AdditionalInfo"
      },
      "AdditionalInfoResult": {
        "properties": {
          "tracking_id": {
            "type": "string",
            "title": "Tracking Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "duplicate_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duplicate Of"
          }
        },
        "type": "object",
        "required": [
          "tracking_id",
          "status"
        ],
        "title": "AdditionalInfoResult",
        "description": "Reply to an additional-info submission. revision is set when the invoice\nwas sent for re-evaluation; duplicate_of when the new details revealed a\nduplicate instead."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceSubmission": {
        "properties": {
          "vendor": {
            "type": "string",
            "minLength": 1,
            "title": "Vendor"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "title": "Category"
          },
          "receipt_present": {
            "type": "boolean",
            "title": "Receipt Present"
          },
          "submitter_email": {
            "type": "string",
            "minLength": 3,
            "title": "Submitter Email"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "title": "Department"
          },
          "attendees": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Attendees"
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "title": "Line Items",
            "default": []
          },
          "tax_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Amount"
          },
          "business_justification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Justification"
          },
          "client_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Name"
          },
          "travel_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Travel Class"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "vendor",
          "amount",
          "category",
          "receipt_present",
          "submitter_email",
          "department"
        ],
        "title": "InvoiceSubmission"
      },
      "LineItem": {
        "properties": {
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "quantity": {
            "type": "number",
            "title": "Quantity",
            "default": 1
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price",
            "default": 0
          }
        },
        "type": "object",
        "title": "LineItem"
      },
      "ReviewActionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "request_more_info"
            ],
            "title": "Action"
          },
          "reviewer_email": {
            "type": "string",
            "minLength": 3,
            "title": "Reviewer Email"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reviewer_email",
          "idempotency_key"
        ],
        "title": "ReviewActionRequest"
      },
      "ReviewActionResult": {
        "properties": {
          "tracking_id": {
            "type": "string",
            "title": "Tracking Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "result": {
            "type": "string",
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "tracking_id",
          "status",
          "result"
        ],
        "title": "ReviewActionResult"
      },
      "SubmissionResult": {
        "properties": {
          "tracking_id": {
            "type": "string",
            "title": "Tracking Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "duplicate_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duplicate Of"
          }
        },
        "type": "object",
        "required": [
          "tracking_id",
          "status"
        ],
        "title": "SubmissionResult",
        "description": "Reply to an invoice submission; duplicate_of appears only for duplicates."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

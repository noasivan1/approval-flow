# Copy to .env and adjust as needed. Do not commit real secrets.

# Logging
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=approvalflow
POSTGRES_DB=approvalflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (backing service for Dapr pub/sub and state store)
REDIS_HOST=redis
REDIS_PORT=6379

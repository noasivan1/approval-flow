GEMINI_API_KEY=api_key
# Logging
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=approvalflow
POSTGRES_DB=approvalflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (backing service for Dapr pub/sub and state store)
REDIS_HOST=redis
REDIS_PORT=6379

# Recommendation provider. Normal runtime uses gemini; tests and CI use stub.
RECOMMENDATION_PROVIDER=gemini

# Gemini API key, read by decision-service through the Dapr secret store.
# Put your own key here after copying this file to .env.
# In Gemini mode, a missing or invalid key routes the invoice to human review
# with AI-PROVIDER-ERROR. It never falls back to the stub.
GEMINI_API_KEY=

# Gemini model used by the normal runtime.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=2
